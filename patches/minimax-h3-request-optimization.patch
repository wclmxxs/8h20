+def _optional_bool(value: Any, field_name: str) -> bool | None:
+    if value is None:
+        return None
+    if not isinstance(value, bool):
+        raise ValueError(f"{field_name} must be a boolean")
+    return value
+
+
+def _optional_bounded_int(
+    value: Any,
+    field_name: str,
+    *,
+    minimum: int,
+    maximum: int,
+) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{field_name} must be an integer")
+    if value < minimum or value > maximum:
+        raise ValueError(
+            f"{field_name} must be in [{minimum}, {maximum}]"
+        )
+    return value
+
+
+def normalize_minimax_h3_optimization(value: Any) -> dict[str, Any] | None:
+    """Validate request-scoped acceleration overrides.
+
+    Unknown keys are ignored so the public API can remain forward-compatible.
+    Missing keys deliberately inherit the process-level deployment defaults.
+    """
+
+    if value is None:
+        return None
+    if not isinstance(value, Mapping):
+        raise ValueError("optimization must be an object")
+
+    normalized: dict[str, Any] = {}
+    sol_attn = value.get("sol_attn")
+    if sol_attn is not None:
+        if not isinstance(sol_attn, Mapping):
+            raise ValueError("optimization.sol_attn must be an object")
+        sol_config: dict[str, Any] = {}
+        enabled = _optional_bool(
+            sol_attn.get("enabled"), "optimization.sol_attn.enabled"
+        )
+        dense_steps = _optional_bounded_int(
+            sol_attn.get("dense_steps"),
+            "optimization.sol_attn.dense_steps",
+            minimum=0,
+            maximum=100,
+        )
+        tau = _optional_positive_finite_float(
+            sol_attn.get("tau"), "optimization.sol_attn.tau"
+        )
+        for name, item in (
+            ("enabled", enabled),
+            ("dense_steps", dense_steps),
+            ("tau", tau),
+        ):
+            if item is not None:
+                sol_config[name] = item
+        normalized["sol_attn"] = sol_config
+
+    cache_dit = value.get("cache_dit")
+    if cache_dit is not None:
+        if not isinstance(cache_dit, Mapping):
+            raise ValueError("optimization.cache_dit must be an object")
+        cache_config: dict[str, Any] = {}
+        enabled = _optional_bool(
+            cache_dit.get("enabled"), "optimization.cache_dit.enabled"
+        )
+        warmup = _optional_bounded_int(
+            cache_dit.get("warmup"),
+            "optimization.cache_dit.warmup",
+            minimum=0,
+            maximum=100,
+        )
+        rdt = _optional_unit_float(
+            cache_dit.get("rdt"), "optimization.cache_dit.rdt"
+        )
+        max_cached = _optional_bounded_int(
+            cache_dit.get("max_continuous_cached_steps"),
+            "optimization.cache_dit.max_continuous_cached_steps",
+            minimum=1,
+            maximum=100,
+        )
+        for name, item in (
+            ("enabled", enabled),
+            ("warmup", warmup),
+            ("rdt", rdt),
+            ("max_continuous_cached_steps", max_cached),
+        ):
+            if item is not None:
+                cache_config[name] = item
+        normalized["cache_dit"] = cache_config
+
+    return normalized
+
