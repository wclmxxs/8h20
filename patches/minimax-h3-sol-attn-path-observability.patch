+_REQUEST_SOL_ATTN_STATS: ContextVar[dict[str, Any] | None] = ContextVar(
+    "request_sol_attn_stats",
+    default=None,
+)
 
 
+def _is_primary_distributed_rank() -> bool:
+    return (
+        not torch.distributed.is_available()
+        or not torch.distributed.is_initialized()
+        or torch.distributed.get_rank() == 0
+    )
+
+
+def _current_denoising_step() -> int | None:
+    try:
+        from sglang.multimodal_gen.runtime.managers.forward_context import (
+            get_forward_context,
+        )
+
+        return int(get_forward_context().current_timestep)
+    except AssertionError:
+        return None
+
+
+def _record_sol_attn_path(*, dense: bool, layer_idx: int | None) -> None:
+    """Collect CPU-only request diagnostics without synchronizing CUDA."""
+
+    stats = _REQUEST_SOL_ATTN_STATS.get()
+    if stats is None:
+        return
+    path = "dense" if dense else "sol"
+    stats[f"{path}_calls"] += 1
+    layer_calls = stats[f"{path}_layers"]
+    layer_calls[layer_idx] = layer_calls.get(layer_idx, 0) + 1
+    step = _current_denoising_step()
+    step_calls = stats["steps"].setdefault(step, {"dense": 0, "sol": 0})
+    step_calls[path] += 1
+    cfg = _get_sol_attn_runtime_config()
+    stats["runtime_configs"].add(
+        (
+            cfg["enabled"],
+            cfg["force_dense"],
+            cfg["tau"],
+            cfg["dense_steps"],
+            cfg["sink_start"],
+            cfg["sink_tokens"],
+            cfg["dense_prefix_rows"],
+        )
+    )
+
+
