+_MINIMAX_H3_PIXEL_FRAMES_PER_LATENT_TOKEN = (1, 4, 4, 4, 4)
+
+
+def _video_latent_prefix_tokens(*, pixel_frames: int, latent_t: int) -> int:
+    """Return the smallest temporal latent prefix covering pixel_frames."""
+
+    if pixel_frames <= 0:
+        return 0
+    covered = 0
+    for latent_index in range(latent_t):
+        covered += _MINIMAX_H3_PIXEL_FRAMES_PER_LATENT_TOKEN[
+            latent_index % len(_MINIMAX_H3_PIXEL_FRAMES_PER_LATENT_TOKEN)
+        ]
+        if covered >= pixel_frames:
+            return latent_index + 1
+    return latent_t
+
+
+def _sol_attn_request_runtime_config(
+    *,
+    config: Mapping[str, Any] | None,
+    ctx: Any,
+    positive: Any,
+    packed: Mapping[str, torch.Tensor],
+    sampling: Any,
+) -> dict[str, Any]:
+    """Resolve exact conditioning and temporal-prefix rows for one request."""
+
+    runtime = dict(config or {})
+    sink_conditioning = str(runtime.get("sink_conditioning", "exact_kv"))
+    target_start = int(positive.img_pos[positive.video_target_start])
+    live_rows = int(packed["cu_seqlens"][1])
+    if not 0 <= target_start < live_rows:
+        raise RuntimeError(
+            "invalid MiniMax H3 target-video span: "
+            f"target_start={target_start}, live_rows={live_rows}"
+        )
+
+    runtime["sink_conditioning"] = sink_conditioning
+    if sink_conditioning != "off" and target_start > 0:
+        runtime["_sink_start"] = 0
+        runtime["_sink_tokens"] = target_start
+    if sink_conditioning == "exact_kv_and_rows" and target_start > 0:
+        runtime["_dense_prefix_rows"] = target_start
+        runtime["_live_rows"] = live_rows
+
+    prefix_seconds = float(runtime.get("dense_prefix_seconds", 0.0) or 0.0)
+    if prefix_seconds <= 0.0:
+        return runtime
+
+    shape = None if ctx.plan is None else ctx.plan.shape
+    if not isinstance(shape, Mapping):
+        raise ValueError(
+            "optimization.sol_attn.dense_prefix_seconds requires a resolved plan"
+        )
+    fps = float(shape["fps"])
+    frame_count = int(shape["frame_count"])
+    target = getattr(sampling, "target", None) or {}
+    requested_duration = float(
+        target.get("duration_seconds", frame_count / fps)
+    )
+    if requested_duration <= prefix_seconds:
+        runtime["_force_dense"] = True
+        return runtime
+
+    prefix_pixel_frames = min(frame_count, math.ceil(prefix_seconds * fps))
+    prefix_latent_t = _video_latent_prefix_tokens(
+        pixel_frames=prefix_pixel_frames,
+        latent_t=int(ctx.latent_t),
+    )
+    frame_rows = (int(ctx.latent_h) // 2) * (int(ctx.latent_w) // 2)
+    prefix_video_rows = prefix_latent_t * frame_rows
+    dense_prefix_rows = target_start + prefix_video_rows
+    if dense_prefix_rows >= live_rows:
+        runtime["_force_dense"] = True
+        return runtime
+    if sink_conditioning == "off":
+        runtime["_sink_start"] = target_start
+        runtime["_sink_tokens"] = prefix_video_rows
+    else:
+        runtime["_sink_start"] = 0
+        runtime["_sink_tokens"] = dense_prefix_rows
+    runtime["_dense_prefix_rows"] = dense_prefix_rows
+    runtime["_live_rows"] = live_rows
+    return runtime
 
 
